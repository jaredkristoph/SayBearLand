# Copy to .env for local dev, or set these in Render > Environment. Never commit real values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random string used to sign login cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Comma-separated usernames that become admins when they sign up
ADMIN_USERNAMES=admin
# Every Redis key starts with this, so an Upstash database can be shared safely
KEY_PREFIX=saybearland:
